# Pinned core stack. The CUDA wheels fetched at pod start (PozzettiAndrea/cuda-wheels, cu128torch2.8) are built for exactly
# this torch. On Linux, PyPI's torch 2.8.0 is the CUDA 12.8 build.
torch==2.8.0
torchvision==0.23.0
torchaudio==2.8.0
xformers==0.0.32.post2

# Extra packages the Trellis2 / MoGe code imports that aren't in either requirements.txt
huggingface_hub[hf_xet]
trimesh
easydict
einops
imageio
imageio-ffmpeg
transformers
accelerate
plyfile
omegaconf
zstandard
scikit-image
matplotlib
# utils3d from PyPI is an old 0.1.x release that can't install on modern Python; MoGe/TRELLIS.2 use this one
utils3d @ git+https://github.com/EasternJournalist/utils3d.git@ca3e9ac015ab3473a37ea60f2f55063696638416
